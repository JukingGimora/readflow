[Unit]
Description=readflow read-only query service
After=network.target

[Service]
WorkingDirectory=%h/projects/snxt-query
Environment=PYTHONPATH=%h/projects/snxt-query/.pylibs:%h/projects/snxt-query
EnvironmentFile=%h/projects/snxt-query/.env
ExecStart=/usr/bin/python3 -m qflow serve
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
